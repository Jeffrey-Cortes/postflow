NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postflow:postflow@localhost:5432/postflow?schema=public"
LOG_LEVEL=log
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# Set these only when STORAGE_DRIVER=s3.
# AWS_REGION=us-east-1
# S3_BUCKET=postflow-media-development

# Telegram credentials are added in Phase 2. Keep real values only in .env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# OpenAI generation. Keep real values only in .env.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local bootstrap. The Telegram user ID is numeric and not a secret.
# INITIAL_ORGANIZATION_NAME=
# INITIAL_ORGANIZATION_SLUG=
# INITIAL_TELEGRAM_USER_ID=
# INITIAL_USER_DISPLAY_NAME=
