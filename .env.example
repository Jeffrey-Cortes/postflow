NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postflow:postflow@localhost:5432/postflow?schema=public"
LOG_LEVEL=log
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

